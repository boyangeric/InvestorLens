# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_MINI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# LangSmith
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=investorlens

# Tavily (news search). Free tier: 1000 queries/month — https://tavily.com
# Leave blank to disable the news tool; the agent falls back to document-only
# answers and the trace records `news_count: 0`.
TAVILY_API_KEY=
